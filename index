                tabPiket.className = "flex-1 py-2 rounded-lg text-slate-600 flex items-center justify-center gap-1.5";
                hintBox.innerHTML = `<div class="font-bold flex items-center gap-1 text-amber-950"><i class="fa-solid fa-key"></i> Akun Demo Admin:</div><div>User: <span class="font-bold">admin</span> | Pass: <span class="font-bold">admin123</span></div>`;
            }
        }

        function handleLoginSubmit(event) {
            event.preventDefault();
            const usernameInput = document.getElementById('login-username').value.trim();
            const passwordInput = document.getElementById('login-password').value.trim();

            const foundUser = userDatabase.find(u => u.username === usernameInput && u.password === passwordInput);

            if (foundUser) {
                authUser = { isLoggedIn: true, role: foundUser.role, username: foundUser.username, name: foundUser.name };

                document.getElementById('btn-header-login').classList.add('hidden');
                document.getElementById('user-logged-badge').classList.remove('hidden');
                document.getElementById('logged-user-name').innerText = foundUser.name;
                document.getElementById('logged-user-role').innerText = foundUser.role.toUpperCase();

                document.getElementById('tab-btn-piket').classList.remove('hidden');
                document.getElementById('tab-btn-laporan').classList.remove('hidden');
                document.getElementById('mob-btn-piket').classList.remove('hidden');
                document.getElementById('mob-btn-laporan').classList.remove('hidden');

                if (foundUser.role === 'admin') {
                    document.getElementById('tab-btn-admin').classList.remove('hidden');
                    document.getElementById('mob-btn-admin').classList.remove('hidden');
                }

                closeLoginModal();
                showToast(`Selamat datang, ${foundUser.name}!`, "success");
                switchTab(foundUser.role === 'admin' ? 'admin' : 'piket');
            } else {
                showToast("Username atau Password tidak cocok!", "error");
            }
        }

        function handleLogout() {
            authUser = { isLoggedIn: false, role: null, username: '', name: '' };
            document.getElementById('btn-header-login').classList.remove('hidden');
            document.getElementById('user-logged-badge').classList.add('hidden');

            document.getElementById('tab-btn-piket').classList.add('hidden');
            document.getElementById('tab-btn-laporan').classList.add('hidden');
            document.getElementById('tab-btn-admin').classList.add('hidden');

            document.getElementById('mob-btn-piket').classList.add('hidden');
            document.getElementById('mob-btn-laporan').classList.add('hidden');
            document.getElementById('mob-btn-admin').classList.add('hidden');

            switchTab('kios');
            showToast("Anda telah keluar dari sistem.", "info");
        }

        function initUSBBufferListener() {
            const usbBuffer = document.getElementById('rfid-usb-buffer');
            if (!usbBuffer) return;

            usbBuffer.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    const cardCode = usbBuffer.value.trim();
                    if (cardCode) processAttendanceTap(cardCode, "USB Reader");
                    usbBuffer.value = '';
                }
            });

            document.body.addEventListener('click', (e) => {
                if (!['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON'].includes(e.target.tagName)) refocusUSBInput();
            });
        }

        function refocusUSBInput() {
            const usbBuffer = document.getElementById('rfid-usb-buffer');
            if (usbBuffer) usbBuffer.focus();
        }

        function handleManualSimulate() {
            const input = document.getElementById('manual-sim-input');
            const val = input.value.trim();
            if (!val) {
                showToast("Silakan ketik UID RFID atau Barcode ID!", "warning");
                return;
            }
            processAttendanceTap(val, "Simulasi Manual");
            input.value = '';
        }

        function setScanMode(mode) {
            const btnUsb = document.getElementById('btn-mode-usb');
            const btnCam = document.getElementById('btn-mode-camera');
            const wrapUsb = document.getElementById('wrapper-usb-input');
            const wrapCam = document.getElementById('wrapper-camera-scanner');

            if (mode === 'usb') {
                btnUsb.className = "px-3 py-1.5 rounded-md bg-white shadow-sm text-brand-600";
                btnCam.className = "px-3 py-1.5 rounded-md text-slate-600";
                wrapUsb.classList.remove('hidden');
                wrapCam.classList.add('hidden');
                stopCameraScanner();
                refocusUSBInput();
            } else {
                btnCam.className = "px-3 py-1.5 rounded-md bg-white shadow-sm text-brand-600";
                btnUsb.className = "px-3 py-1.5 rounded-md text-slate-600";
                wrapUsb.classList.add('hidden');
                wrapCam.classList.remove('hidden');
                startCameraScanner();
            }
        }

        function startCameraScanner() {
            if (html5QrCodeScanner) return;
            html5QrCodeScanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: 250 });
            html5QrCodeScanner.render((decodedText) => {
                processAttendanceTap(decodedText, "Kamera HP/Webcam");
            }, () => {});
        }

        function stopCameraScanner() {
            if (html5QrCodeScanner) {
                html5QrCodeScanner.clear().catch(e => console.error(e));
                html5QrCodeScanner = null;
            }
        }

        function processAttendanceTap(idCard, sourceName) {
            const student = studentDatabase.find(s => s.rfid === idCard || s.barcode === idCard);
            if (!student) {
                showToast(`Kartu (${idCard}) tidak terdaftar dalam sistem!`, "error");
                return;
            }

            const now = new Date();
            const todayStr = now.toISOString().split('T')[0];
            const timeStr = now.toLocaleTimeString('id-ID', { hour12: false });

            const isDuplicate = attendanceLogs.some(log => log.nis === student.nis && log.tanggal === todayStr);
            if (isDuplicate) {
                showToast(`${student.nama} sudah melakukan presensi hari ini!`, "warning");
                renderActiveResult(student, timeStr, "Siswa Sudah Absen Hari Ini");
                return;
            }

            const [limitH, limitM] = systemConfig.jamMasuk.split(':').map(Number);
            const currentH = now.getHours();
            const currentM = now.getMinutes();

            let status = "Tepat Waktu";
            if (currentH > limitH || (currentH === limitH && currentM > limitM)) {
                status = "Terlambat";
            }

            const logEntry = {
                id: Date.now(), tanggal: todayStr, jam: timeStr, nis: student.nis,
                nama: student.nama, kelas: student.kelas, status: status, sumber: sourceName,
                keterangan: "Hadir via Tapping", waSent: true, waPhone: student.waOrtu
            };

            attendanceLogs.unshift(logEntry);
            renderActiveResult(student, timeStr, status);
            renderRecentKioskLogs();
            renderReportTable();
            showToast(`Presensi Berhasil: ${student.nama} (${status})`, "success");

            if (systemConfig.gasUrl && !systemConfig.gasUrl.includes("TEMPEL_URL_GAS_WEB_APP_ANDA_DISINI")) {
                sendToGoogleSheets({ action: "absen", id_card: idCard, source: sourceName });
            }
        }

        function sendToGoogleSheets(payload) {
            fetch(systemConfig.gasUrl, {
                method: "POST",
                mode: "no-cors",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            }).catch(err => console.error("Gagal sinkronisasi data ke Google Sheets:", err));
        }

        function renderActiveResult(student, timeStr, statusText) {
            document.getElementById('result-idle').classList.add('hidden');
            document.getElementById('result-active').classList.remove('hidden');

            document.getElementById('res-photo').src = student.photo || "https://placehold.co/120x120/2563eb/ffffff?text=SISWA";
            document.getElementById('res-nama').innerText = student.nama;
            document.getElementById('res-nis-kelas').innerText = `NIS: ${student.nis} • Kelas ${student.kelas}`;
            document.getElementById('res-timestamp').innerText = `${timeStr} WIB`;

            const badge = document.getElementById('res-status-badge');
            if (statusText === 'Tepat Waktu') badge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-emerald-100 text-emerald-800 inline-block mb-1";
            else if (statusText === 'Terlambat') badge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-amber-100 text-amber-800 inline-block mb-1";
            else badge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-rose-100 text-rose-800 inline-block mb-1";
            
            badge.innerText = statusText;
            document.getElementById('res-wa-phone').innerText = student.waOrtu;
            document.getElementById('res-wa-msg').innerText = `"Assalamu'alaikum. Ananda ${student.nama} (${student.kelas}) telah hadir di sekolah pada ${timeStr} WIB. Status: ${statusText}."`;
        }

        function renderRecentKioskLogs() {
            const tbody = document.getElementById('table-kios-recent');
            const countLabel = document.getElementById('live-count-today');

            const today = new Date().toISOString().split('T')[0];
            const todayLogs = attendanceLogs.filter(l => l.tanggal === today);

            if (countLabel) countLabel.innerText = `Total Hadir: ${todayLogs.length} Siswa`;

            if (todayLogs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400 italic">Belum ada aktivitas presensi hari ini.</td></tr>`;
                return;
            }

            tbody.innerHTML = todayLogs.slice(0, 5).map(log => `
                <tr class="hover:bg-slate-50 transition">
                    <td class="p-2.5 font-mono text-slate-800 font-bold">${log.jam}</td>
                    <td class="p-2.5 font-semibold text-slate-900">${log.nama}</td>
                    <td class="p-2.5 text-slate-500">${log.kelas}</td>
                    <td class="p-2.5">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold ${log.status === 'Tepat Waktu' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                            ${log.status}
                        </span>
                    </td>
                    <td class="p-2.5 text-right font-mono text-emerald-600">
                        <i class="fa-brands fa-whatsapp text-sm"></i> Terkirim
                    </td>
                </tr>
            `).join('');
        }

        function populatePiketStudentDropdown() {
            const select = document.getElementById('piket-select-siswa');
            if (!select) return;
            select.innerHTML = `<option value="">-- Cari Nama / NIS Siswa --</option>` +
                studentDatabase.map(s => `<option value="${s.nis}">${s.nis} - ${s.nama} (${s.kelas})</option>`).join('');
        }

        function handlePiketSubmit(event) {
            event.preventDefault();
            const nis = document.getElementById('piket-select-siswa').value;
            const status = document.getElementById('piket-status').value;
            const tanggal = document.getElementById('piket-tanggal').value;
            const sendWa = document.getElementById('piket-send-wa').value;
            const keterangan = document.getElementById('piket-keterangan').value;

            const student = studentDatabase.find(s => s.nis === nis);
            if (!student) return;

            const timeStr = new Date().toLocaleTimeString('id-ID', { hour12: false });
            attendanceLogs.unshift({
                id: Date.now(), tanggal, jam: timeStr, nis: student.nis, nama: student.nama,
                kelas: student.kelas, status, sumber: "Guru Piket", keterangan, waSent: sendWa === 'ya', waPhone: student.waOrtu
            });

            renderReportTable();
            showToast(`Data presensi ${student.nama} (${status}) berhasil disimpan!`, "success");
            document.getElementById('form-piket-entry').reset();
            setTodayDateDefault();
        }

        function renderReportTable() {
            const tbody = document.getElementById('table-laporan-body');
            if (!tbody) return;

            const filterDate = document.getElementById('filter-date').value;
            const filterKelas = document.getElementById('filter-kelas').value;
            const filterStatus = document.getElementById('filter-status').value;
            const filterSearch = document.getElementById('filter-search').value.toLowerCase();

            document.getElementById('stat-total').innerText = studentDatabase.length;

            const today = filterDate || new Date().toISOString().split('T')[0];
            const logsToday = attendanceLogs.filter(l => l.tanggal === today);

            document.getElementById('stat-ontime').innerText = logsToday.filter(l => l.status === 'Tepat Waktu').length;
            document.getElementById('stat-late').innerText = logsToday.filter(l => l.status === 'Terlambat').length;
            document.getElementById('stat-permission').innerText = logsToday.filter(l => ['Izin', 'Sakit'].includes(l.status)).length;
            document.getElementById('stat-absent').innerText = Math.max(0, studentDatabase.length - logsToday.length);

            let displayList = studentDatabase.map(student => {
                const log = logsToday.find(l => l.nis === student.nis);
                return log ? { ...log } : {
                    id: 'absent-' + student.nis, tanggal: today, jam: '--:--:--', nis: student.nis,
                    nama: student.nama, kelas: student.kelas, status: 'Alpa', sumber: '-', keterangan: 'Belum Melakukan Absen',
                    waSent: false, waPhone: student.waOrtu
                };
            });

            displayList = displayList.filter(item => {
                const matchKelas = !filterKelas || item.kelas === filterKelas;
                const matchStatus = !filterStatus || item.status === filterStatus;
                const matchSearch = !filterSearch || item.nama.toLowerCase().includes(filterSearch) || item.nis.includes(filterSearch);
                return matchKelas && matchStatus && matchSearch;
            });

            if (displayList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-slate-400 italic">Data presensi tidak ditemukan.</td></tr>`;
                return;
            }

            tbody.innerHTML = displayList.map(item => `
                <tr class="hover:bg-slate-50 transition">
                    <td class="p-3 font-mono font-semibold text-slate-800">${item.nis}</td>
                    <td class="p-3 font-bold text-slate-900">${item.nama}</td>
                    <td class="p-3 text-slate-600">${item.kelas}</td>
                    <td class="p-3 font-mono text-slate-700">${item.jam}</td>
                    <td class="p-3">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${
                            item.status === 'Tepat Waktu' ? 'bg-emerald-100 text-emerald-800' :
                            item.status === 'Terlambat' ? 'bg-amber-100 text-amber-800' :
                            ['Izin', 'Sakit'].includes(item.status) ? 'bg-blue-100 text-blue-800' : 'bg-rose-100 text-rose-800'
                        }">${item.status}</span>
                    </td>
                    <td class="p-3 text-slate-500">${item.keterangan}</td>
                    <td class="p-3 text-right">
                        <button onclick="sendDirectWA('${item.waPhone}', '${item.nama}', '${item.status}')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-[11px] font-semibold transition">
                            <i class="fa-brands fa-whatsapp"></i> WA
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function sendDirectWA(phone, name, status) {
            const msg = `Halo Bapak/Ibu, menginformasikan bahwa ananda ${name} terdata dengan status presensi: ${status} pada hari ini. Terima kasih.`;
            window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        function renderUserTable() {
            const tbody = document.getElementById('table-admin-users');
            if (!tbody) return;
            tbody.innerHTML = userDatabase.map(u => `
                <tr class="hover:bg-slate-50 transition">
                    <td class="p-2.5 font-mono font-bold text-brand-600">${u.username}</td>
                    <td class="p-2.5 font-semibold text-slate-900">${u.name}</td>
                    <td class="p-2.5"><span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${u.role === 'admin' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'}">${u.role}</span></td>
                    <td class="p-2.5 font-mono text-slate-500">••••••••</td>
                    <td class="p-2.5 text-right space-x-1">
                        <button onclick="editUser('${u.username}')" class="p-1 bg-slate-100 text-slate-700 rounded"><i class="fa-solid fa-pen"></i></button>
                        <button onclick="deleteUser('${u.username}')" class="p-1 bg-rose-50 text-rose-600 rounded"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function openModalUser() {
            document.getElementById('modal-user-title').innerText = "Tambah Akun Pengguna";
            document.getElementById('form-user').reset();
            document.getElementById('mu-original-username').value = "";
            document.getElementById('modal-user').classList.remove('hidden');
        }
        function closeModalUser() { document.getElementById('modal-user').classList.add('hidden'); }

        function editUser(username) {
            const u = userDatabase.find(item => item.username === username);
            if (!u) return;
            document.getElementById('modal-user-title').innerText = "Edit Akun Pengguna";
            document.getElementById('mu-original-username').value = u.username;
            document.getElementById('mu-username').value = u.username;
            document.getElementById('mu-nama').value = u.name;
            document.getElementById('mu-role').value = u.role;
            document.getElementById('mu-password').value = u.password;
            document.getElementById('modal-user').classList.remove('hidden');
        }

        function deleteUser(username) {
            if (userDatabase.length <= 1) return showToast("Tidak bisa menghapus user terakhir!", "error");
            userDatabase = userDatabase.filter(u => u.username !== username);
            renderUserTable();
            showToast("User berhasil dihapus!", "success");
        }

        function handleSaveUser(event) {
            event.preventDefault();
            const origUsername = document.getElementById('mu-original-username').value;
            const username = document.getElementById('mu-username').value.trim();
            const name = document.getElementById('mu-nama').value.trim();
            const role = document.getElementById('mu-role').value;
            const password = document.getElementById('mu-password').value.trim();

            if (origUsername) {
                const u = userDatabase.find(item => item.username === origUsername);
                if (u) { u.username = username; u.name = name; u.role = role; u.password = password; }
            } else {
                if (userDatabase.some(item => item.username === username)) return showToast("Username sudah digunakan!", "error");
                userDatabase.push({ username, name, role, password });
            }
            renderUserTable();
            closeModalUser();
            showToast("Data pengguna berhasil disimpan!", "success");
        }

        function renderAdminSiswaTable() {
            const tbody = document.getElementById('table-admin-siswa');
            const countLabel = document.getElementById('admin-siswa-count');
            if (!tbody) return;
            if (countLabel) countLabel.innerText = studentDatabase.length;

            tbody.innerHTML = studentDatabase.map(s => `
                <tr class="hover:bg-slate-50 transition">
                    <td class="p-2.5 font-mono font-bold text-slate-800">${s.nis}</td>
                    <td class="p-2.5 font-semibold text-slate-900">${s.nama}</td>
                    <td class="p-2.5 text-slate-600">${s.kelas}</td>
                    <td class="p-2.5 font-mono text-xs text-brand-600 bg-brand-50 rounded px-1.5 py-0.5 inline-block">${s.rfid}</td>
                    <td class="p-2.5 font-mono text-xs text-slate-600">${s.barcode}</td>
                    <td class="p-2.5 font-mono text-slate-600">${s.waOrtu}</td>
                    <td class="p-2.5 text-right space-x-1">
                        <button onclick="editSiswa('${s.nis}')" class="p-1 bg-slate-100 text-slate-700 rounded"><i class="fa-solid fa-pen"></i></button>
                        <button onclick="deleteSiswa('${s.nis}')" class="p-1 bg-rose-50 text-rose-600 rounded"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function openModalSiswa() {
            document.getElementById('modal-siswa-title').innerText = "Tambah Siswa Baru";
            document.getElementById('form-siswa').reset();
            document.getElementById('m-original-nis').value = "";
            document.getElementById('modal-siswa').classList.remove('hidden');
        }
        function closeModalSiswa() { document.getElementById('modal-siswa').classList.add('hidden'); }

        function editSiswa(nis) {
            const s = studentDatabase.find(item => item.nis === nis);
            if (!s) return;
            document.getElementById('modal-siswa-title').innerText = "Edit Data Siswa";
            document.getElementById('m-original-nis').value = s.nis;
            document.getElementById('m-nis').value = s.nis;
            document.getElementById('m-nama').value = s.nama;
            document.getElementById('m-kelas').value = s.kelas;
            document.getElementById('m-rfid').value = s.rfid;
            document.getElementById('m-barcode').value = s.barcode;
            document.getElementById('m-wa').value = s.waOrtu;
            document.getElementById('modal-siswa').classList.remove('hidden');
        }

        function deleteSiswa(nis) {
            studentDatabase = studentDatabase.filter(s => s.nis !== nis);
            renderAdminSiswaTable();
            populatePiketStudentDropdown();
            renderReportTable();
            showToast("Data siswa berhasil dihapus!", "success");
        }

        function handleSaveSiswa(event) {
            event.preventDefault();
            const origNis = document.getElementById('m-original-nis').value;
            const nis = document.getElementById('m-nis').value.trim();
            const nama = document.getElementById('m-nama').value.trim();
            const kelas = document.getElementById('m-kelas').value;
            const rfid = document.getElementById('m-rfid').value.trim();
            const barcode = document.getElementById('m-barcode').value.trim();
            const waOrtu = document.getElementById('m-wa').value.trim();

            if (origNis) {
                const s = studentDatabase.find(item => item.nis === origNis);
                if (s) { s.nis = nis; s.nama = nama; s.kelas = kelas; s.rfid = rfid; s.barcode = barcode; s.waOrtu = waOrtu; }
            } else {
                if (studentDatabase.some(item => item.nis === nis)) return showToast("NIS sudah terdaftar!", "error");
                studentDatabase.push({ nis, nama, kelas, rfid, barcode, waOrtu });
            }
            renderAdminSiswaTable();
            populatePiketStudentDropdown();
            renderReportTable();
            closeModalSiswa();
            showToast("Data siswa berhasil disimpan!", "success");
        }

        function saveSystemSettings() {
            systemConfig.jamMasuk = document.getElementById('cfg-jam-masuk').value;
            systemConfig.jamReminder = document.getElementById('cfg-jam-reminder').value;
            systemConfig.waProvider = document.getElementById('cfg-wa-provider').value;
            systemConfig.waToken = document.getElementById('cfg-wa-token').value;
            systemConfig.gasUrl = document.getElementById('cfg-gas-url').value;

            document.getElementById('disp-rule-ontime').innerText = `${systemConfig.jamMasuk} WIB`;
            document.getElementById('disp-rule-reminder').innerText = `${systemConfig.jamReminder} WIB`;
            showToast("Pengaturan sistem & WA Gateway berhasil diperbarui!", "success");
        }

        function exportToCSV() {
            if (attendanceLogs.length === 0) return showToast("Belum ada data presensi untuk diexport!", "warning");
            let csvContent = "data:text/csv;charset=utf-8,Tanggal,Jam,NIS,Nama,Kelas,Status,Sumber,Keterangan\n";
            attendanceLogs.forEach(l => {
                csvContent += `"${l.tanggal}","${l.jam}","${l.nis}","${l.nama}","${l.kelas}","${l.status}","${l.sumber}","${l.keterangan}"\n`;
            });
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Laporan_Absensi_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            link.remove();
            showToast("Laporan CSV berhasil diunduh!", "success");
        }
    </script>
</body>
