<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartAbsen RFID & Barcode Terpadu</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- HTML5 QRCode Scanner Library -->
    <script src="https://unpkg.com/html5-qrcode"></script>

    <style>
        .scan-pulse {
            box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7);
            animation: pulse-ring 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
        }
        @keyframes pulse-ring {
            to { box-shadow: 0 0 0 20px rgba(37, 99, 235, 0); }
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="h-full flex flex-col font-sans text-slate-800 antialiased selection:bg-brand-500 selection:text-white">

    <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Title -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-xl font-black text-white shadow-lg">
                        <i class="fa-solid fa-id-card-clip"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg leading-tight tracking-tight">SmartAbsen RFID & Barcode</h1>
                        <p class="text-xs text-slate-400">Sistem Absensi Terpadu & WA Gateway</p>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex items-center space-x-1 text-sm font-medium">
                    <button onclick="switchTab('kios')" id="tab-btn-kios" class="tab-btn px-3 py-2 rounded-lg bg-brand-600 text-white flex items-center gap-2 transition">
                        <i class="fa-solid fa-desktop"></i> Kios Tapping
                    </button>
                    <button onclick="switchTab('piket')" id="tab-btn-piket" class="tab-btn hidden px-3 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 flex items-center gap-2 transition">
                        <i class="fa-solid fa-user-pen"></i> Guru Piket
                    </button>
                    <button onclick="switchTab('laporan')" id="tab-btn-laporan" class="tab-btn hidden px-3 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 flex items-center gap-2 transition">
                        <i class="fa-solid fa-chart-pie"></i> Portal Laporan
                    </button>
                    <button onclick="switchTab('admin')" id="tab-btn-admin" class="tab-btn hidden px-3 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 flex items-center gap-2 transition">
                        <i class="fa-solid fa-users-gear"></i> Admin & Akun
                    </button>
                    <button onclick="switchTab('docs')" id="tab-btn-docs" class="tab-btn px-3 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 flex items-center gap-2 transition">
                        <i class="fa-solid fa-code"></i> Script Google
                    </button>
                </nav>

                <!-- Live Status Clock & Login Button -->
                <div class="flex items-center gap-3">
                    <div class="text-right hidden sm:block">
                        <div id="clock-time" class="text-base font-bold tracking-wider font-mono text-brand-100">00:00:00</div>
                        <div id="clock-date" class="text-xs text-slate-400">Sabtu, 1 Ags 2026</div>
                    </div>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <span class="w-2 h-2 mr-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Standby
                    </span>

                    <div id="header-user-widget" class="border-l border-slate-700 pl-3 ml-1">
                        <button onclick="openLoginModal()" id="btn-header-login" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 transition shadow">
                            <i class="fa-solid fa-right-to-bracket"></i> Login
                        </button>
                        <div id="user-logged-badge" class="hidden flex items-center gap-2">
                            <div class="text-right text-xs">
                                <div id="logged-user-name" class="font-bold text-slate-200">Admin</div>
                                <div id="logged-user-role" class="text-[10px] text-brand-300 font-mono">ADMIN</div>
                            </div>
                            <button onclick="handleLogout()" title="Logout" class="p-1.5 bg-slate-800 hover:bg-rose-600 text-slate-300 hover:text-white rounded-lg transition text-xs">
                                <i class="fa-solid fa-power-off"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Bar -->
        <div class="md:hidden border-t border-slate-800 bg-slate-900/95 px-2 py-2 flex justify-around text-xs">
            <button onclick="switchTab('kios')" class="p-2 text-slate-300 flex flex-col items-center gap-1"><i class="fa-solid fa-desktop text-base"></i> Kios</button>
            <button onclick="switchTab('piket')" id="mob-btn-piket" class="p-2 text-slate-300 hidden flex-col items-center gap-1"><i class="fa-solid fa-user-pen text-base"></i> Piket</button>
            <button onclick="switchTab('laporan')" id="mob-btn-laporan" class="p-2 text-slate-300 hidden flex-col items-center gap-1"><i class="fa-solid fa-chart-pie text-base"></i> Laporan</button>
            <button onclick="switchTab('admin')" id="mob-btn-admin" class="p-2 text-slate-300 hidden flex-col items-center gap-1"><i class="fa-solid fa-users-gear text-base"></i> Admin</button>
            <button onclick="switchTab('docs')" class="p-2 text-slate-300 flex flex-col items-center gap-1"><i class="fa-solid fa-code text-base"></i> Code</button>
        </div>
    </header>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none"></div>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <section id="pane-kios" class="tab-pane space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Scanner Panel & Mode Switcher -->
                <div class="lg:col-span-5 space-y-6">
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-wifi text-brand-600"></i> Mode Pemindaian Kartu
                            </h2>
                            <div class="flex bg-slate-100 p-1 rounded-lg text-xs font-semibold">
                                <button onclick="setScanMode('usb')" id="btn-mode-usb" class="px-3 py-1.5 rounded-md bg-white shadow-sm text-brand-600">USB / RFID</button>
                                <button onclick="setScanMode('camera')" id="btn-mode-camera" class="px-3 py-1.5 rounded-md text-slate-600">Kamera Cam</button>
                            </div>
                        </div>

                        <!-- USB RFID Listener Panel -->
                        <div id="wrapper-usb-input" class="space-y-4">
                            <div class="relative flex items-center justify-center p-8 border-2 border-dashed border-slate-300 rounded-xl bg-slate-50 text-center hover:border-brand-500 transition group">
                                <div class="space-y-3">
                                    <div class="w-16 h-16 mx-auto rounded-full bg-brand-50 text-brand-600 flex items-center justify-center text-2xl scan-pulse">
                                        <i class="fa-solid fa-credit-card"></i>
                                    </div>
                                    <div>
                                        <p class="font-semibold text-slate-800 text-sm">Tempelkan Kartu RFID / Barcode Scanner</p>
                                        <p class="text-xs text-slate-500 mt-1">Reader USB Windows / IoT siap menerima tap kartu</p>
                                    </div>
                                    <span class="inline-block text-[10px] bg-slate-200 px-2 py-0.5 rounded text-slate-600 font-mono">Listener USB Aktif</span>
                                </div>
                                <input type="text" id="rfid-usb-buffer" class="absolute opacity-0 inset-0 w-full h-full cursor-pointer" autofocus autocomplete="off">
                            </div>

                            <!-- Manual Test Simulation -->
                            <div class="pt-2 border-t border-slate-100">
                                <label class="block text-xs font-medium text-slate-500 mb-1">Simulasi Ketik Manual UID / Barcode (Uji Coba):</label>
                                <div class="flex gap-2">
                                    <input type="text" id="manual-sim-input" placeholder="Contoh: RFID-1001 atau BC-1001" class="flex-1 px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none font-mono">
                                    <button onclick="handleManualSimulate()" class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-medium hover:bg-slate-700 transition">Tap</button>
                                </div>
                            </div>
                        </div>

                        <!-- Camera Scanner Canvas -->
                        <div id="wrapper-camera-scanner" class="hidden space-y-4">
                            <div class="overflow-hidden rounded-xl border border-slate-200 bg-black aspect-video relative">
                                <div id="qr-reader" class="w-full"></div>
                            </div>
                            <p class="text-xs text-center text-slate-500"><i class="fa-solid fa-circle-info mr-1"></i> Arahkan Barcode Kartu Pelajar ke Kamera Web/HP</p>
                        </div>
                    </div>

                    <!-- Attendance Rules Info Box -->
                    <div class="bg-indigo-950 text-indigo-100 rounded-2xl p-5 shadow-sm space-y-3">
                        <div class="flex items-center justify-between border-b border-indigo-800/80 pb-3">
                            <span class="text-xs font-medium uppercase tracking-wider text-indigo-300">Aturan Presensi Hari Ini</span>
                            <i class="fa-solid fa-clock-rotate-left text-indigo-400"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-3 text-xs">
                            <div class="bg-indigo-900/50 p-3 rounded-xl border border-indigo-800/50">
                                <div class="text-indigo-400 mb-0.5">Batas Tepat Waktu</div>
                                <div class="font-bold text-base text-white font-mono" id="disp-rule-ontime">07:00 WIB</div>
                            </div>
                            <div class="bg-indigo-900/50 p-3 rounded-xl border border-indigo-800/50">
                                <div class="text-indigo-400 mb-0.5">Trigger Auto WA Alpa</div>
                                <div class="font-bold text-base text-amber-300 font-mono" id="disp-rule-reminder">08:00 WIB</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-7 space-y-6">
                    <div id="result-card-container" class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 transition-all duration-300 min-h-[220px]">
                        <!-- Initial Idle State -->
                        <div id="result-idle" class="py-8 flex flex-col items-center justify-center text-center space-y-3">
                            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 text-2xl">
                                <i class="fa-solid fa-user-check"></i>
                            </div>
                            <h3 class="font-bold text-slate-700 text-base">Menunggu Tapping Siswa</h3>
                            <p class="text-xs text-slate-400 max-w-xs">Tempelkan kartu RFID atau scan barcode untuk mencatat kehadiran secara otomatis.</p>
                        </div>

                        <!-- Active Tap Result -->
                        <div id="result-active" class="hidden space-y-5">
                            <div class="flex items-start justify-between border-b border-slate-100 pb-4">
                                <div class="flex items-center gap-4">
                                    <img id="res-photo" src="https://placehold.co/120x120/2563eb/ffffff?text=SISWA" alt="Foto Siswa" class="w-20 h-20 rounded-2xl object-cover border-2 border-slate-100 shadow-sm">
                                    <div>
                                        <span id="res-status-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-emerald-100 text-emerald-800 inline-block mb-1">Tepat Waktu</span>
                                        <h3 id="res-nama" class="font-extrabold text-xl text-slate-900 leading-tight">M. Rayhan Farisi</h3>
                                        <p id="res-nis-kelas" class="text-sm text-slate-500">NIS: 20261001 • Kelas XII MIPA 1</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-xs text-slate-400">Waktu Absen</div>
                                    <div id="res-timestamp" class="text-lg font-bold font-mono text-slate-800">06:48:12 WIB</div>
                                </div>
                            </div>

                            <!-- WhatsApp Dispatch Banner -->
                            <div id="res-wa-banner" class="rounded-xl p-4 bg-emerald-50 border border-emerald-200 flex items-start gap-3 text-xs">
                                <div id="res-wa-icon" class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0 text-sm">
                                    <i class="fa-brands fa-whatsapp"></i>
                                </div>
                                <div class="flex-1 space-y-1">
                                    <div class="flex items-center justify-between">
                                        <span id="res-wa-title" class="font-bold text-emerald-950">Notifikasi WA Terkirim ke Orang Tua</span>
                                        <span id="res-wa-phone" class="font-mono text-emerald-700">6281234567890</span>
                                    </div>
                                    <p id="res-wa-msg" class="text-emerald-800 font-mono text-[11px] bg-white/70 p-2 rounded border border-emerald-100">
                                        "Assalamu'alaikum. Ananda M. Rayhan Farisi (XII MIPA 1) telah hadir di sekolah pada 06:48 WIB."
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Live Log Table -->
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-list-check text-brand-600"></i> Riwayat Absensi Terkini
                            </h3>
                            <span class="text-xs text-slate-500" id="live-count-today">Total Hadir: 0 Siswa</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs text-slate-600">
                                <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <tr>
                                        <th class="p-2.5">Waktu</th>
                                        <th class="p-2.5">Siswa</th>
                                        <th class="p-2.5">Kelas</th>
                                        <th class="p-2.5">Status</th>
                                        <th class="p-2.5 text-right">Notifikasi WA</th>
                                    </tr>
                                </thead>
                                <tbody id="table-kios-recent" class="divide-y divide-slate-100">
                                    <tr>
                                        <td colspan="5" class="p-4 text-center text-slate-400 italic">Belum ada aktivitas presensi hari ini.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="pane-piket" class="tab-pane hidden space-y-6">
            <div class="max-w-3xl mx-auto bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                <div class="border-b border-slate-100 pb-4 mb-6">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-user-pen text-brand-600"></i> Input Manual Presensi Guru Piket & Wali Kelas
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">Mencatat ketidakhadiran siswa karena Izin, Sakit, atau Alpa secara resmi.</p>
                </div>

                <form id="form-piket-entry" onsubmit="handlePiketSubmit(event)" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Pilih Siswa *</label>
                            <select id="piket-select-siswa" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none">
                                <option value="">-- Cari Nama / NIS Siswa --</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Status Kehadiran *</label>
                            <select id="piket-status" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none">
                                <option value="Izin">Izin</option>
                                <option value="Sakit">Sakit</option>
                                <option value="Alpa">Alpa / Tanpa Keterangan</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal *</label>
                            <input type="date" id="piket-tanggal" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Kirim Notifikasi WA ke Ortu?</label>
                            <select id="piket-send-wa" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none">
                                <option value="ya">Ya, Kirim Pesan WA</option>
                                <option value="tidak">Tidak Perlu</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Alasan / Catatan Keterangan *</label>
                        <textarea id="piket-keterangan" rows="3" required placeholder="Contoh: Surat dokter terlampir / Izin acara keluarga" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none"></textarea>
                    </div>

                    <div class="pt-2 flex justify-end">
                        <button type="submit" class="px-6 py-2.5 bg-brand-600 text-white rounded-xl text-sm font-semibold hover:bg-brand-700 shadow-md transition flex items-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i> Simpan & Kirim Keterangan
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <section id="pane-laporan" class="tab-pane hidden space-y-6">
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="text-xs text-slate-500 mb-1">Total Siswa</div>
                    <div class="text-2xl font-black text-slate-900" id="stat-total">0</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-emerald-200 bg-emerald-50/30 shadow-sm">
                    <div class="text-xs text-emerald-600 font-medium mb-1">Tepat Waktu</div>
                    <div class="text-2xl font-black text-emerald-700" id="stat-ontime">0</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-amber-200 bg-amber-50/30 shadow-sm">
                    <div class="text-xs text-amber-600 font-medium mb-1">Terlambat</div>
                    <div class="text-2xl font-black text-amber-700" id="stat-late">0</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-blue-200 bg-blue-50/30 shadow-sm">
                    <div class="text-xs text-blue-600 font-medium mb-1">Izin / Sakit</div>
                    <div class="text-2xl font-black text-blue-700" id="stat-permission">0</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-rose-200 bg-rose-50/30 shadow-sm col-span-2 sm:col-span-1">
                    <div class="text-xs text-rose-600 font-medium mb-1">Belum Absen (Alpa)</div>
                    <div class="text-2xl font-black text-rose-700" id="stat-absent">0</div>
                </div>
            </div>

            <!-- Filter & Search Bar -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <input type="date" id="filter-date" onchange="renderReportTable()" class="px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <select id="filter-kelas" onchange="renderReportTable()" class="px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <option value="">Semua Kelas</option>
                        <option value="X MIPA 1">X MIPA 1</option>
                        <option value="XI IPS 2">XI IPS 2</option>
                        <option value="XII MIPA 1">XII MIPA 1</option>
                    </select>
                    <select id="filter-status" onchange="renderReportTable()" class="px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <option value="">Semua Status</option>
                        <option value="Tepat Waktu">Tepat Waktu</option>
                        <option value="Terlambat">Terlambat</option>
                        <option value="Izin">Izin</option>
                        <option value="Sakit">Sakit</option>
                        <option value="Alpa">Alpa / Belum Absen</option>
                    </select>
                </div>
                <div class="flex items-center gap-2 w-full md:w-auto">
                    <input type="text" id="filter-search" oninput="renderReportTable()" placeholder="Cari Nama / NIS..." class="px-3 py-1.5 text-xs border border-slate-300 rounded-lg w-full md:w-48 focus:outline-none">
                    <button onclick="exportToCSV()" class="px-3 py-1.5 bg-slate-800 text-white rounded-lg text-xs font-semibold hover:bg-slate-700 transition flex items-center gap-1 shrink-0">
                        <i class="fa-solid fa-file-csv"></i> Export CSV
                    </button>
                </div>
            </div>

            <!-- Attendance Table -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
                            <tr>
                                <th class="p-3">NIS</th>
                                <th class="p-3">Nama Siswa</th>
                                <th class="p-3">Kelas</th>
                                <th class="p-3">Jam Masuk</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Keterangan</th>
                                <th class="p-3 text-right">Aksi WA</th>
                            </tr>
                        </thead>
                        <tbody id="table-laporan-body" class="divide-y divide-slate-100">
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="pane-admin" class="tab-pane hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
